# Local development only. Generate your own secret before starting Django.
DJANGO_SECRET_KEY=replace-with-a-new-random-secret-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=videoflix
POSTGRES_USER=videoflix
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Keep timeouts when adapting the Redis URL. Use rediss:// with TLS if needed.
REDIS_URL=redis://localhost:6379/0?socket_connect_timeout=2&socket_timeout=10

FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:5500
# Tokenless JSON requires an exact match in all three origin lists.
# Set empty to require Django CSRF tokens for every unsafe request.
CSRF_TRUSTED_JSON_ORIGINS=http://127.0.0.1:5500
ACTIVATION_PATH=/pages/auth/activate.html
PASSWORD_RESET_PATH=/pages/auth/confirm_password.html
ACTIVATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Safe default: writes messages locally, does not contact SMTP.
# Use django.core.mail.backends.smtp.EmailBackend for approved delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=noreply@example.com

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT=1800
FFMPEG_THREADS=2

# Optional absolute paths; leave unset to use the project defaults.
# MEDIA_ROOT=D:/videoflix/media
# PRIVATE_MEDIA_ROOT=D:/videoflix/private_media

# Copy to .env in the project root. Replace all change-me values before use.
# Single quotes preserve literal $ and # in secrets during Compose parsing.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD='change-me-admin-password'
DJANGO_SUPERUSER_EMAIL=admin@example.com

SECRET_KEY='change-me-generate-a-private-random-secret-at-least-50-characters'
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

DB_NAME=videoflix
DB_USER=videoflix
DB_PASSWORD='change-me-database-password'
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD='your_email_user_password'
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
# SMTP is the default. For local offline use, select the filebased backend:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=/app/test-mail

# Existing frontend contract and local HTTP operation.
FRONTEND_URL=http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CSRF_TRUSTED_JSON_ORIGINS=http://127.0.0.1:5500
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=False
ACTIVATION_PATH=/pages/auth/activate.html
PASSWORD_RESET_PATH=/pages/auth/confirm_password.html
ACTIVATION_TIMEOUT=86400
PASSWORD_RESET_TIMEOUT=3600

FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFMPEG_TIMEOUT=1800
FFMPEG_THREADS=2
MEDIA_ROOT=/app/media
PRIVATE_MEDIA_ROOT=/app/private_media

# Unique default protects volumes of the previous project named videoflix.
# Choose a stable, unique name before first startup. Do not change it later.
COMPOSE_PROJECT_NAME=videoflix-academy
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
